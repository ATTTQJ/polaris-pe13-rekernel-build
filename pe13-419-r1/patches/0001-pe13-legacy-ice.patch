@@ -39,6 +39,12 @@ int crypto_qti_program_key(struct crypto_vops_qti_entry *ice_entry,
 		u32 words[BLK_CRYPTO_MAX_WRAPPED_KEY_SIZE / sizeof(u32)];
 	} key_new;
 
+	if (IS_ENABLED(CONFIG_QTI_CRYPTO_LEGACY_SCM) &&
+	    (storage_type != UFS_CE || key->is_hw_wrapped ||
+	     key->crypto_mode != BLK_ENCRYPTION_MODE_AES_256_XTS ||
+	     key->size != 64 || slot < 2 || slot > 31))
+		return -EOPNOTSUPP;
+
 	err = qtee_shmbridge_allocate_shm(key->size, &shm);
