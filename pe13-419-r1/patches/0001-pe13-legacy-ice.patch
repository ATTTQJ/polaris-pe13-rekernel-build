+CONFIG_QTI_CRYPTO_LEGACY_SCM=y
diff --git a/drivers/scsi/ufs/ufshcd-crypto-qti.c b/drivers/scsi/ufs/ufshcd-crypto-qti.c
index a552fd37136e2cf4bbaa171bf4f58d2b284fbd3d..6e3cb5beab7d0f31ea2a45bffee201fe545ea120 100644
--- a/drivers/scsi/ufs/ufshcd-crypto-qti.c
+++ b/drivers/scsi/ufs/ufshcd-crypto-qti.c
@@ -27,6 +27,26 @@
 
 #define NUM_KEYSLOTS(hba) (hba->crypto_capabilities.config_count + 1)
 
+/* The legacy firmware reserves physical keyslots 0 and 1 for FDE. */
+static unsigned int ufshcd_crypto_qti_num_keyslots(struct ufs_hba *hba)
+{
+	unsigned int slots = ufshcd_num_keyslots(hba);
+
+	if (IS_ENABLED(CONFIG_QTI_CRYPTO_LEGACY_SCM)) {
+		slots = min(slots, 32U);
+		return slots > 2 ? slots - 2 : 0;
+	}
+	return slots;
+}
+
+static unsigned int ufshcd_crypto_qti_hw_keyslot(struct ufs_hba *hba,
+					       unsigned int slot)
+{
+	if (slot >= ufshcd_crypto_qti_num_keyslots(hba))
+		return ufshcd_num_keyslots(hba); /* Invalid hardware slot. */
+	return slot + (IS_ENABLED(CONFIG_QTI_CRYPTO_LEGACY_SCM) ? 2 : 0);
+}
+
 static struct ufs_hba_crypto_variant_ops ufshcd_crypto_qti_variant_ops = {
 	.hba_init_crypto = ufshcd_crypto_qti_init_crypto,
 	.enable = ufshcd_crypto_qti_enable,
@@ -85,6 +105,8 @@ static int ufshcd_crypto_qti_keyslot_program(struct keyslot_manager *ksm,
 	u8 data_unit_mask;
 	int crypto_alg_id;
 
+	slot = ufshcd_crypto_qti_hw_keyslot(hba, slot);
+
 	crypto_alg_id = ufshcd_crypto_cap_find(hba, key->crypto_mode,
 					       key->data_unit_size);
 
@@ -127,6 +149,8 @@ static int ufshcd_crypto_qti_keyslot_evict(struct keyslot_manager *ksm,
 	int err = 0;
 	struct ufs_hba *hba = keyslot_manager_private(ksm);
 
+	slot = ufshcd_crypto_qti_hw_keyslot(hba, slot);
+
 	if (!ufshcd_is_crypto_enabled(hba) ||
 	    !ufshcd_keyslot_valid(hba, slot))
 		return -EINVAL;
@@ -190,6 +214,7 @@ static int ufshcd_hba_init_crypto_qti_spec(struct ufs_hba *hba,
 	int err = 0;
 	unsigned int crypto_modes_supported[BLK_ENCRYPTION_MODE_MAX];
 	enum blk_crypto_mode_num blk_mode_num;
+	unsigned int features = BLK_CRYPTO_FEATURE_STANDARD_KEYS;
 
 	/* Default to disabling crypto */
 	hba->caps &= ~UFSHCD_CAP_CRYPTO;
@@ -238,10 +263,16 @@ static int ufshcd_hba_init_crypto_qti_spec(struct ufs_hba *hba,
 			hba->crypto_cap_array[cap_idx].sdus_mask * 512;
 	}
 
-	hba->ksm = keyslot_manager_create(hba->dev, ufshcd_num_keyslots(hba),
+	if (!ufshcd_crypto_qti_num_keyslots(hba)) {
+		err = -ENODEV;
+		goto out;
+	}
+	if (!IS_ENABLED(CONFIG_QTI_CRYPTO_LEGACY_SCM))
+		features |= BLK_CRYPTO_FEATURE_WRAPPED_KEYS;
+	hba->ksm = keyslot_manager_create(hba->dev,
+					  ufshcd_crypto_qti_num_keyslots(hba),
 					  ksm_ops,
-					  BLK_CRYPTO_FEATURE_STANDARD_KEYS |
-					  BLK_CRYPTO_FEATURE_WRAPPED_KEYS,
+					  features,
 					  crypto_modes_supported, hba);
 
 	if (!hba->ksm) {
@@ -298,6 +329,7 @@ int ufshcd_crypto_qti_prep_lrbp_crypto(struct ufs_hba *hba,
 {
 	struct bio_crypt_ctx *bc;
 	int ret = 0;
+	unsigned int hw_slot;
 #if IS_ENABLED(CONFIG_CRYPTO_DEV_QCOM_ICE)
 	struct ice_data_setting setting;
 	bool bypass = true;
@@ -337,11 +369,12 @@ int ufshcd_crypto_qti_prep_lrbp_crypto(struct ufs_hba *hba,
 		 */
 		return -EINVAL;
 	}
-	if (!ufshcd_keyslot_valid(hba, bc->bc_keyslot))
+	hw_slot = ufshcd_crypto_qti_hw_keyslot(hba, bc->bc_keyslot);
+	if (!ufshcd_keyslot_valid(hba, hw_slot))
 		return -EINVAL;
 
 	lrbp->crypto_enable = true;
-	lrbp->crypto_key_slot = bc->bc_keyslot;
+	lrbp->crypto_key_slot = hw_slot;
 	if (bc->is_ext4) {
 		lrbp->data_unit_num = (u64)cmd->request->bio->bi_iter.bi_sector;
 		lrbp->data_unit_num >>= 3;
