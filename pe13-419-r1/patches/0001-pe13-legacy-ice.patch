diff --git a/fs/crypto/Kconfig b/fs/crypto/Kconfig
index fbf7b094703b5f6929060ccc029b975418c21b95..83ab0bf2aee5f6d36369f1fd82a442fdd7f2196f 100644
--- a/fs/crypto/Kconfig
+++ b/fs/crypto/Kconfig
@@ -38,3 +38,16 @@ config ENABLE_LEGACY_PFK
 	  from nonce and master key. In private mode the keys
 	  will be used by inline crypto hardware to encrypt the
 	  file content.
+
+config FSCRYPT_LEGACY_ICE_PE13
+	bool "PE13 Polaris legacy F2FS ICE compatibility"
+	depends on MACH_XIAOMI_D5X && F2FS_FS
+	depends on FS_ENCRYPTION_INLINE_CRYPT && SCSI_UFS_CRYPTO_QTI
+	depends on !BLK_INLINE_ENCRYPTION_FALLBACK
+	select ENABLE_LEGACY_PFK
+	help
+	  Preserve the v1 PRIVATE-mode per-file key derivation used by the
+	  PE13 Polaris 4.9 kernel. Select hardware inline encryption for these
+	  F2FS files even when the old fstab omits the inlinecrypt option.
+	  Refuse unsupported PRIVATE policies instead of using software crypto.
+	  This requires separate validation of the firmware ICE interface.
diff --git a/fs/crypto/inline_crypt.c b/fs/crypto/inline_crypt.c
index 30fd821305665c2f7c4b3adff36e7ac0c0cec9d0..e639065bdcbbcfbf74870deea99849f47b0aab0e 100644
--- a/fs/crypto/inline_crypt.c
+++ b/fs/crypto/inline_crypt.c
@@ -105,18 +105,32 @@ int fscrypt_select_encryption_impl(struct fscrypt_info *ci,
 	struct request_queue **devs;
 	int num_devs;
 	int i;
+	bool legacy_ice = IS_ENABLED(CONFIG_FSCRYPT_LEGACY_ICE_PE13) &&
+		fscrypt_policy_contents_mode(&ci->ci_policy) ==
+		FSCRYPT_MODE_PRIVATE;
 
 	/* The file must need contents encryption, not filenames encryption */
 	if (!S_ISREG(inode->i_mode))
 		return 0;
 
+	/* PE13's v1 F2FS ICE format requires the UFS hardware path. */
+	if (legacy_ice &&
+	    (ci->ci_policy.version != FSCRYPT_POLICY_V1 ||
+	     strcmp(sb->s_type->name, "f2fs") ||
+	     sb->s_blocksize != 4096 || is_hw_wrapped_key ||
+	     (fscrypt_policy_flags(&ci->ci_policy) &
+	      ~FSCRYPT_POLICY_FLAGS_PAD_MASK))) {
+		fscrypt_warn(inode, "Unsupported PE13 legacy ICE policy");
+		return -EOPNOTSUPP;
+	}
+
 	/* blk-crypto must implement the needed encryption algorithm */
 	if (crypto_mode == BLK_ENCRYPTION_MODE_INVALID)
-		return 0;
+		return legacy_ice ? -EOPNOTSUPP : 0;
 
-	/* The filesystem must be mounted with -o inlinecrypt */
-	if (!sb->s_cop->inline_crypt_enabled ||
-	    !sb->s_cop->inline_crypt_enabled(sb))
+	/* The original PE13 fstab predates the inlinecrypt mount option. */
+	if (!legacy_ice && (!sb->s_cop->inline_crypt_enabled ||
+	    !sb->s_cop->inline_crypt_enabled(sb)))
 		return 0;
 
 	/*
@@ -138,12 +152,14 @@ int fscrypt_select_encryption_impl(struct fscrypt_info *ci,
 	 */
 
 	if (IS_ENABLED(CONFIG_BLK_INLINE_ENCRYPTION_FALLBACK) &&
-	    !is_hw_wrapped_key) {
+	    !is_hw_wrapped_key && !legacy_ice) {
 		ci->ci_inlinecrypt = true;
 		return 0;
 	}
 
 	num_devs = fscrypt_get_num_devices(sb);
+	if (num_devs < 1)
+		return -EINVAL;
 	devs = kmalloc_array(num_devs, sizeof(*devs), GFP_NOFS);
 	if (!devs)
 		return -ENOMEM;
@@ -164,6 +180,10 @@ int fscrypt_select_encryption_impl(struct fscrypt_info *ci,
 	ci->ci_inlinecrypt = true;
 out_free_devs:
 	kfree(devs);
+	if (legacy_ice && !ci->ci_inlinecrypt) {
+		fscrypt_warn(inode, "PE13 legacy ICE requires compatible hardware");
+		return -EOPNOTSUPP;
+	}
 	return 0;
 }
 
