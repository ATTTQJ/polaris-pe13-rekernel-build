 		return -ENOMEM;
@@ -47,7 +53,7 @@ int crypto_qti_program_key(struct crypto_vops_qti_entry *ice_entry,
 
 	memcpy(key_new.bytes, key->raw, key->size);
 	if (!key->is_hw_wrapped) {
-		for (i = 0; i < ARRAY_SIZE(key_new.words); i++)
+		for (i = 0; i < key->size / sizeof(key_new.words[0]); i++)
 			__cpu_to_be32s(&key_new.words[i]);
 	}
 
@@ -63,12 +69,20 @@ int crypto_qti_program_key(struct crypto_vops_qti_entry *ice_entry,
 	desc.args[4] = data_unit_mask;
 	desc.args[5] = storage_type;
 
+	if (IS_ENABLED(CONFIG_QTI_CRYPTO_LEGACY_SCM)) {
+		smc_id = TZ_ES_CONFIG_SET_ICE_KEY_ID;
+		desc.arginfo = TZ_ES_CONFIG_SET_ICE_KEY_PARAM_ID;
+		desc.args[5] = 0;
+	}
 
 	err = scm_call2_noretry(smc_id, &desc);
 	if (err)
 		pr_err("%s:SCM call Error: 0x%x slot %d\n",
 				__func__, err, slot);
 
+	memzero_explicit(&key_new, sizeof(key_new));
+	memzero_explicit(tzbuf, key->size);
+	dmac_flush_range(tzbuf, tzbuf + key->size);
 	qtee_shmbridge_free_shm(&shm);
 
 	return err;
@@ -87,6 +101,14 @@ int crypto_qti_invalidate_key(
 	desc.args[0] = slot;
 	desc.args[1] = storage_type;
 
+	if (IS_ENABLED(CONFIG_QTI_CRYPTO_LEGACY_SCM)) {
+		if (storage_type != UFS_CE || slot < 2 || slot > 31)
+			return -EOPNOTSUPP;
+		smc_id = TZ_ES_INVALIDATE_ICE_KEY_ID;
+		desc.arginfo = TZ_ES_INVALIDATE_ICE_KEY_PARAM_ID;
+		desc.args[1] = 0;
+	}
+
 	err = scm_call2_noretry(smc_id, &desc);
 	if (err)
 		pr_err("%s:SCM call Error: 0x%x\n", __func__, err);
@@ -104,6 +126,9 @@ int crypto_qti_tz_raw_secret(const u8 *wrapped_key,
 	struct scm_desc desc = {0};
 	char *tzbuf_key;
 
+	if (IS_ENABLED(CONFIG_QTI_CRYPTO_LEGACY_SCM))
+		return -EOPNOTSUPP;
+
 	err = qtee_shmbridge_allocate_shm(wrapped_key_size, &shm_key);
 	if (err)
 		return -ENOMEM;
diff --git a/drivers/soc/qcom/crypto-qti-tz.h b/drivers/soc/qcom/crypto-qti-tz.h
