diff --git a/techpack/display/msm/msm_atomic.c b/techpack/display/msm/msm_atomic.c
index ddd966d7..b1bc7295 100644
--- a/techpack/display/msm/msm_atomic.c
+++ b/techpack/display/msm/msm_atomic.c
@@ -24,6 +24,24 @@
 
 #define MULTIPLE_CONN_DETECTED(x) (x > 1)
 
+/* 4.9 vendor reads these two fence fds via OBJ_SETPROPERTY after the frame
+ * commit. They are queries, not additional frames. Keep the existing SDE
+ * fence creation/copy/error paths and serialize access as the 4.9 path did.
+ */
+bool msm_atomic_pe13_legacy_fence(struct drm_mode_object *obj,
+		struct drm_property *prop)
+{
+	struct msm_drm_private *priv = prop->dev->dev_private;
+
+	if (!IS_ENABLED(CONFIG_FSCRYPT_LEGACY_ICE_PE13) || !priv)
+		return false;
+	if (obj->type == DRM_MODE_OBJECT_CRTC)
+		return prop == priv->crtc_property[CRTC_PROP_OUTPUT_FENCE];
+	if (obj->type == DRM_MODE_OBJECT_CONNECTOR)
+		return prop == priv->conn_property[CONNECTOR_PROP_RETIRE_FENCE];
+	return false;
+}
+
 struct msm_commit {
 	struct drm_device *dev;
 	struct drm_atomic_state *state;
