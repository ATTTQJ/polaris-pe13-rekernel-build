diff --git a/drivers/gpu/drm/drm_mode_object.c b/drivers/gpu/drm/drm_mode_object.c
index 57cc9aa6..45c4dc98 100644
--- a/drivers/gpu/drm/drm_mode_object.c
+++ b/drivers/gpu/drm/drm_mode_object.c
@@ -496,6 +496,40 @@ static int set_property_atomic(struct drm_mode_object *obj,
 	return ret;
 }
 
+static int set_property_pe13_fence(struct drm_mode_object *obj,
+		struct drm_property *prop, uint64_t value)
+{
+	struct drm_device *dev = prop->dev;
+	struct drm_mode_object *ref;
+	int ret = -EINVAL;
+
+	if (!IS_ENABLED(CONFIG_FSCRYPT_LEGACY_ICE_PE13) ||
+			!dev->mode_config.funcs ||
+			!dev->mode_config.funcs->pe13_legacy_fence ||
+			!dev->mode_config.funcs->pe13_legacy_fence(obj, prop))
+		return -ENOIOCTLCMD;
+	if (!drm_property_change_valid_get(prop, value, &ref))
+		return -EINVAL;
+
+	drm_modeset_lock_all(dev);
+	if (obj->type == DRM_MODE_OBJECT_CRTC) {
+		struct drm_crtc *crtc = obj_to_crtc(obj);
+
+		if (crtc->state && crtc->funcs->atomic_set_property)
+			ret = crtc->funcs->atomic_set_property(crtc, crtc->state,
+					prop, value);
+	} else if (obj->type == DRM_MODE_OBJECT_CONNECTOR) {
+		struct drm_connector *conn = obj_to_connector(obj);
+
+		if (conn->state && conn->funcs->atomic_set_property)
+			ret = conn->funcs->atomic_set_property(conn, conn->state,
+					prop, value);
+	}
+	drm_property_change_valid_put(prop, ref);
+	drm_modeset_unlock_all(dev);
+	return ret;
+}
+
 int drm_mode_obj_set_property_ioctl(struct drm_device *dev, void *data,
 				    struct drm_file *file_priv)
 {
@@ -518,6 +552,10 @@ int drm_mode_obj_set_property_ioctl(struct drm_device *dev, void *data,
 	if (!property)
 		goto out_unref;
 
+	ret = set_property_pe13_fence(arg_obj, property, arg->value);
+	if (ret != -ENOIOCTLCMD)
+		goto out_unref;
+
 	if (drm_drv_uses_atomic_modeset(property->dev))
 		ret = set_property_atomic(arg_obj, property, arg->value);
 	else
