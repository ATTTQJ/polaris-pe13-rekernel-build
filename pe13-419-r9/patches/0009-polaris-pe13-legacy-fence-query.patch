 	/**
 	 * @fb_create:
 	 *
@@ -325,6 +328,17 @@ struct drm_mode_config_funcs {
 	 * &drm_private_state and &drm_private_obj.
 	 */
 	void (*atomic_state_free)(struct drm_atomic_state *state);
+	/**
+	 * @pe13_legacy_fence:
+	 * Optional PE13 compatibility for legacy vendor fence-property queries.
+	 * Called after object access and property membership checks. Select only
+	 * metadata queries; the core validates the value and calls the existing
+	 * atomic property setter under modeset locks, without a frame commit.
+	 * The selector itself must not modify state.
+	 */
+	bool (*pe13_legacy_fence)(struct drm_mode_object *obj,
+			struct drm_property *prop);
+
 };
 
