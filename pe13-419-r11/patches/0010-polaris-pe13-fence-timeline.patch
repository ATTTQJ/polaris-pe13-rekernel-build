+static uint32_t _sde_crtc_output_fence_offset(struct drm_crtc *crtc,
+		const struct drm_crtc_state *state, bool is_vid)
+{
+	struct sde_crtc_state *cstate = to_sde_crtc_state(state);
+	uint32_t offset = sde_crtc_get_property(cstate,
+			CRTC_PROP_OUTPUT_FENCE_OFFSET);
+
+	/* The legacy ioctl queries the already submitted frame. Atomic-list
+	 * queries use a new state before prepare_commit advances the timeline.
+	 * Current-state access is serialized by the PE13 DRM core path.
+	 */
+	if (IS_ENABLED(CONFIG_FSCRYPT_LEGACY_ICE_PE13) && state == crtc->state)
+		return is_vid ? offset + 1 : 0;
+	return offset + (is_vid ? 1 : 0) + 1;
+}
