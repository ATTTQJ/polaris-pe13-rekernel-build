+#ifdef CONFIG_ZRAM_MULTI_COMP
+/* Use the spare slot flag bits for a coarse boottime timestamp. */
+#define ZRAM_ACCESS_SHIFT __NR_ZRAM_PAGEFLAGS
+#define ZRAM_ACCESS_MASK (ULONG_MAX >> ZRAM_ACCESS_SHIFT)
+
+static bool zram_idle_for(struct zram *zram, u32 index, unsigned int seconds)
+{
+	unsigned long then = zram->table[index].flags >> ZRAM_ACCESS_SHIFT;
+	unsigned long now = ktime_get_boottime_seconds();
+
+	return ((now - then) & ZRAM_ACCESS_MASK) >= seconds;
