+/* The pre-4.12 shim uses dma-buf fds as handles. Match 4.9 handle priority. */
+int ion_pe13_cache_flush(const struct ion_pe13_flush_data *data, unsigned int op)
+{
+	int fd = data->handle > 0 ? data->handle : data->fd;
+
+	return ion_pe13_cache_sync(fd, data->offset, data->length, op);
+}
