+static long compat_ion_pe13_cache_ioctl(unsigned int cmd, unsigned long arg)
+{
+	struct compat_ion_pe13_flush_data data;
+	struct ion_pe13_flush_data flush;
+	void __user *payload = compat_ptr(arg);
+
+	if (!IS_ENABLED(CONFIG_FSCRYPT_LEGACY_ICE_PE13))
+		return -ENOIOCTLCMD;
+	if (cmd == COMPAT_ION_PE13_IOC_CUSTOM) {
+		struct compat_ion_pe13_custom_data custom;
+
+		if (copy_from_user(&custom, payload, sizeof(custom)))
+			return -EFAULT;
+		cmd = custom.cmd;
+		payload = compat_ptr(custom.arg);
+	}
+	if (cmd != COMPAT_ION_PE13_IOC_CLEAN && cmd != COMPAT_ION_PE13_IOC_INV &&
+			cmd != COMPAT_ION_PE13_IOC_CLEAN_INV)
+		return -ENOIOCTLCMD;
+	if (copy_from_user(&data, payload, sizeof(data)))
+		return -EFAULT;
+	flush.handle = data.handle;
+	flush.fd = data.fd;
+	flush.vaddr = NULL; /* Cache operations use only the owned dma-buf. */
+	flush.offset = data.offset;
+	flush.length = data.length;
+	return ion_pe13_cache_flush(&flush, _IOC_NR(cmd));
+}
