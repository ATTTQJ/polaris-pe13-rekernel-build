diff --git a/techpack/display/msm/sde/sde_color_processing.c b/techpack/display/msm/sde/sde_color_processing.c
index d60ff7a5..4fae17ed 100644
--- a/techpack/display/msm/sde/sde_color_processing.c
+++ b/techpack/display/msm/sde/sde_color_processing.c
@@ -1923,6 +1923,33 @@ void sde_cp_crtc_install_properties(struct drm_crtc *crtc)
 
 }
 
+bool sde_cp_pe13_legacy_color_property(const struct msm_drm_private *priv,
+		const struct drm_property *property)
+{
+	static const enum sde_cp_crtc_features staged[] = {
+		SDE_CP_CRTC_DSPP_IGC,
+		SDE_CP_CRTC_DSPP_PCC,
+		SDE_CP_CRTC_DSPP_GC,
+		SDE_CP_CRTC_DSPP_HSIC,
+		SDE_CP_CRTC_DSPP_MEMCOL_SKIN,
+		SDE_CP_CRTC_DSPP_MEMCOL_SKY,
+		SDE_CP_CRTC_DSPP_MEMCOL_FOLIAGE,
+		SDE_CP_CRTC_DSPP_MEMCOL_PROT,
+		SDE_CP_CRTC_DSPP_SIXZONE,
+		SDE_CP_CRTC_DSPP_GAMUT,
+	};
+	size_t i;
+
+	if (!priv->cp_property || !(property->flags & DRM_MODE_PROP_BLOB))
+		return false;
+
+	for (i = 0; i < ARRAY_SIZE(staged); i++)
+		if (priv->cp_property[staged[i]] == property)
+			return true;
+
+	return false;
+}
+
 int sde_cp_crtc_set_property(struct drm_crtc *crtc,
 				struct drm_property *property,
 				uint64_t val)
