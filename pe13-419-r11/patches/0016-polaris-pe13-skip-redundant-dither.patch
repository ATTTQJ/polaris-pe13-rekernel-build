 #include "sde_trace.h"
 
 #define MULTIPLE_CONN_DETECTED(x) (x > 1)
@@ -44,6 +46,67 @@ bool msm_atomic_pe13_legacy_property(struct drm_mode_object *obj,
 	return false;
 }
 
+bool msm_atomic_pe13_legacy_noop(struct drm_atomic_state *state,
+		struct drm_mode_object *obj, struct drm_property *prop,
+		uint64_t value)
+{
+	struct msm_drm_private *priv = state->dev->dev_private;
+	struct drm_connector_state *conn_state;
+	struct drm_crtc_state *crtc_state;
+	struct drm_connector *connector;
+	struct sde_connector *sde_conn;
+	struct dsi_display *display;
+	bool pending, ready;
+
+	if (!IS_ENABLED(CONFIG_DRM_MSM_SDE) || !priv || value ||
+	    obj->type != DRM_MODE_OBJECT_CONNECTOR ||
+	    prop != priv->conn_property[CONNECTOR_PROP_PP_DITHER] ||
+	    !(prop->flags & DRM_MODE_PROP_BLOB) ||
+	    READ_ONCE(priv->shutdown_in_progress))
+		return false;
+
+	connector = obj_to_connector(obj);
+	if (connector->connector_type != DRM_MODE_CONNECTOR_DSI ||
+	    connector->status != connector_status_connected)
+		return false;
+
+	conn_state = drm_atomic_get_old_connector_state(state, connector);
+	if (!conn_state || !conn_state->crtc ||
+	    sde_connector_get_property(conn_state, CONNECTOR_PROP_PP_DITHER) ||
+	    sde_connector_get_property(conn_state, CONNECTOR_PROP_LP) !=
+			SDE_MODE_DPMS_ON)
+		return false;
+	crtc_state = drm_atomic_get_old_crtc_state(state, conn_state->crtc);
+	if (!crtc_state || !crtc_state->enable || !crtc_state->active ||
+	    drm_atomic_crtc_needs_modeset(crtc_state))
+		return false;
+
+	/* A previous commit can still be programming hardware after its swap. */
+	spin_lock(&priv->pending_crtcs_event.lock);
+	pending = (priv->pending_crtcs & drm_crtc_mask(conn_state->crtc)) ||
+		  priv->pending_planes;
+	spin_unlock(&priv->pending_crtcs_event.lock);
+	if (pending)
+		return false;
+
+	sde_conn = to_sde_connector(connector);
+	display = sde_conn->display;
+	if (!display || !display->panel || !mutex_trylock(&sde_conn->lock))
+		return false;
+	/* Value 0 selects the already installed default PP dither blob. */
+	ready = sde_conn->blob_dither &&
+		sde_conn->dpms_mode == DRM_MODE_DPMS_ON &&
+		sde_conn->last_panel_power_mode == SDE_MODE_DPMS_ON &&
+		READ_ONCE(sde_conn->allow_bl_update) &&
+		!READ_ONCE(sde_conn->panel_dead) &&
+		!READ_ONCE(sde_conn->bl_scale_dirty) &&
+		READ_ONCE(display->panel->panel_initialized) &&
+		!READ_ONCE(display->is_cont_splash_enabled) &&
+		!READ_ONCE(display->poms_pending);
+	mutex_unlock(&sde_conn->lock);
+	return ready;
+}
+
 struct msm_commit {
 	struct drm_device *dev;
 	struct drm_atomic_state *state;
