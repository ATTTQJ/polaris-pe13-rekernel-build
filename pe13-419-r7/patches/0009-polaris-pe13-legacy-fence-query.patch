diff --git a/techpack/display/msm/msm_atomic.c b/techpack/display/msm/msm_atomic.c
index ddd966d7..6c6e6131 100644
--- a/techpack/display/msm/msm_atomic.c
+++ b/techpack/display/msm/msm_atomic.c
@@ -24,6 +24,49 @@
 
 #define MULTIPLE_CONN_DETECTED(x) (x > 1)
 
+/* 4.9 vendor reads these two fence fds via OBJ_SETPROPERTY after the frame
+ * commit. They are queries, not additional frames. Keep the existing SDE
+ * fence creation/copy/error paths and serialize access as the 4.9 path did.
+ */
+int msm_atomic_pe13_legacy_fence(struct drm_mode_object *obj,
+		struct drm_property *prop, uint64_t value)
+{
+	struct drm_device *dev = prop->dev;
+	struct msm_drm_private *priv = dev->dev_private;
+	struct drm_mode_object *ref;
+	int ret;
+
+	if (!IS_ENABLED(CONFIG_FSCRYPT_LEGACY_ICE_PE13) || !priv)
+		return -ENOIOCTLCMD;
+	if (obj->type == DRM_MODE_OBJECT_CRTC) {
+		if (prop != priv->crtc_property[CRTC_PROP_OUTPUT_FENCE])
+			return -ENOIOCTLCMD;
+	} else if (obj->type == DRM_MODE_OBJECT_CONNECTOR) {
+		if (prop != priv->conn_property[CONNECTOR_PROP_RETIRE_FENCE])
+			return -ENOIOCTLCMD;
+	} else {
+		return -ENOIOCTLCMD;
+	}
+	if (!drm_property_change_valid_get(prop, value, &ref))
+		return -EINVAL;
+
+	drm_modeset_lock_all(dev);
+	if (obj->type == DRM_MODE_OBJECT_CRTC) {
+		struct drm_crtc *crtc = obj_to_crtc(obj);
+
+		ret = crtc->funcs->atomic_set_property(crtc, crtc->state,
+				prop, value);
+	} else {
+		struct drm_connector *conn = obj_to_connector(obj);
+
+		ret = conn->funcs->atomic_set_property(conn, conn->state,
+				prop, value);
+	}
+	drm_property_change_valid_put(prop, ref);
+	drm_modeset_unlock_all(dev);
+	return ret;
+}
+
 struct msm_commit {
 	struct drm_device *dev;
 	struct drm_atomic_state *state;
