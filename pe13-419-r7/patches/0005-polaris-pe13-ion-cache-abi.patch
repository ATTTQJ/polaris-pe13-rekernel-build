diff --git a/drivers/staging/android/ion/ion.c b/drivers/staging/android/ion/ion.c
index cd653bfa..17d2d133 100644
--- a/drivers/staging/android/ion/ion.c
+++ b/drivers/staging/android/ion/ion.c
@@ -36,6 +36,9 @@
 #include <soc/qcom/secure_buffer.h>
 
 #include "ion.h"
+#ifdef CONFIG_ION_LEGACY
+#include "ion_legacy.h"
+#endif
 #include "ion_secure_util.h"
 #include "compat_ion.h"
 
@@ -1034,6 +1037,56 @@ static const struct dma_buf_ops dma_buf_ops = {
 	.get_flags = ion_dma_buf_get_flags,
 };
 
+#ifdef CONFIG_ION_LEGACY
+/* No userspace virtual address is dereferenced; the fd owns the buffer. */
+int ion_pe13_cache_sync(int fd, unsigned int offset, unsigned int length,
+		unsigned int op)
+{
+	struct dma_buf *dmabuf;
+	int ret;
+
+	if (!IS_ENABLED(CONFIG_FSCRYPT_LEGACY_ICE_PE13) ||
+			!IS_ENABLED(CONFIG_ION_FORCE_DMA_SYNC))
+		return -EOPNOTSUPP;
+	if (op > 2)
+		return -EINVAL;
+
+	dmabuf = dma_buf_get(fd);
+	if (IS_ERR(dmabuf))
+		return PTR_ERR(dmabuf);
+	if (dmabuf->ops != &dma_buf_ops || offset > dmabuf->size ||
+			length > dmabuf->size - offset) {
+		ret = -EINVAL;
+		goto out;
+	}
+	if (!length) {
+		ret = 0;
+		goto out;
+	}
+
+	/*
+	 * Use the existing cache-only callbacks (no kmap reference changes).
+	 * Sync the full buffer, also for partial requests, so multi-segment
+	 * heaps work and no untrusted virtual address reaches cache code.
+	 * FORCE_DMA_SYNC initializes the backing SG DMA addresses at alloc.
+	 */
+	if (op == 0)
+		ret = __ion_dma_buf_end_cpu_access(dmabuf, DMA_TO_DEVICE, false);
+	else if (op == 1)
+		ret = __ion_dma_buf_begin_cpu_access(dmabuf, DMA_FROM_DEVICE, false);
+	else {
+		ret = __ion_dma_buf_end_cpu_access(dmabuf, DMA_BIDIRECTIONAL, false);
+		if (!ret)
+			ret = __ion_dma_buf_begin_cpu_access(dmabuf,
+					DMA_BIDIRECTIONAL, false);
+	}
+
+out:
+	dma_buf_put(dmabuf);
+	return ret;
+}
+#endif
+
 struct dma_buf *ion_alloc_dmabuf(size_t len, unsigned int heap_id_mask,
 				 unsigned int flags)
 {
