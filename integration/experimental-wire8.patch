+#ifdef CONFIG_REKERNEL_NETWORK
+/* Called at the same TCP receive sites used by the 8.0.0 network KPM. */
+void rekernel_tcp_notify(struct sock *sk, struct sk_buff *skb, int version)
+{
+	const struct tcphdr *th;
+	uid_t uid;
+	int data_len;
+
+	if (!READ_ONCE(netlink_unit) || !sk || !skb || !sk_fullsock(sk))
+		return;
+	uid = sock_i_uid(sk).val;
+	if (uid < MIN_USERAPP_UID || !net_uid_monitored(uid))
+		return;
+	if (!pskb_may_pull(skb, sizeof(struct tcphdr)))
+		return;
+	th = tcp_hdr(skb);
+	if (!th || th->doff < 5)
+		return;
+	data_len = (int)skb->len - skb_transport_offset(skb) - (th->doff << 2);
+	if (data_len <= 0 && !th->syn && !th->fin && !th->rst)
+		return;
+	rekernel_report(NETWORK, version, data_len, NULL, uid, NULL, true, NULL);
+}
+#endif
 struct netlink_kernel_cfg cfg = {
 	.input = netlink_rcv_msg, // set recv callback
 };
